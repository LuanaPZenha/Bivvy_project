{
  "name": "bivvy",
  "version": "1.0.0",
  "private": true,
  "description": "Bivvy — outdoor gear rental marketplace (mobile + microservices)",
  "workspaces": [
    "backend/api-gateway",
    "backend/auth-service",
    "backend/core-service",
    "backend/shared",
    "mobile"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,yml}\"",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=backend/api-gateway --workspace=backend/auth-service --workspace=backend/core-service",
    "test:mobile": "npm run test --workspace=mobile",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
