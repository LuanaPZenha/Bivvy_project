{
  "name": "bivvy-core-service",
  "version": "1.0.0",
  "private": true,
  "description": "Bivvy Core Service — gear listings and search",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
