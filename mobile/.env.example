# Expo public env (loaded automatically from this file when you run `npx expo start`).
# Copy real Google Web OAuth client ids from Google Cloud Console.

EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Web OAuth client ID (…apps.googleusercontent.com) — required for Continue with Google on web
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Native clients — required on device / Expo Go
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
