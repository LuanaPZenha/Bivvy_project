# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# Postgres
POSTGRES_USER=bivvy
POSTGRES_PASSWORD=change_me_strong_password
AUTH_DATABASE_URL=postgresql://bivvy:change_me_strong_password@postgres:5432/bivvy_auth
CORE_DATABASE_URL=postgresql://bivvy:change_me_strong_password@postgres:5432/bivvy_core

# Redis
REDIS_URL=redis://redis:6379

# JWT — generate long random secrets (e.g. openssl rand -base64 64)
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret

# Mobile (Expo) — public API base only; never put secrets in the client
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In (Web OAuth client from Google Cloud Console)
# Load from the downloaded client_secret_*.json via: powershell -File scripts/load-google-credentials.ps1
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_web_client_secret
# Public client id for Expo (same as GOOGLE_CLIENT_ID; never put the secret here)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
