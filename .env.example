# Copy to .env — never commit secrets.

NODE_ENV=development
PORT=3000

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES_IN=7d

# Demo account (seeded on boot). The password is not printed in logs.
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@bivvy.test
DEMO_USER_PASSWORD=BivvyDemo123

# Optional. Login and register are limited per IP.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Set true only behind a trusted reverse proxy.
# Vercel sets VERCEL=1 and the app trusts that one hop automatically.
# TRUST_PROXY=false
# On Vercel, NODE_ENV is production. Set JWT_ACCESS_SECRET in the project
# environment to a unique value. Do not commit that value.
